<?xml version="1.0" encoding="UTF-8"?>
<module type="JAVA_MODULE" version="4">
  <component name="NewModuleRootManager" inherit-compiler-output="true">
    <output url="file://$MODULE_DIR$/api/build/main" />
    <output-test url="file://$MODULE_DIR$/api/build/test" />
    <exclude-output />
    <content url="file://$MODULE_DIR$">
      <!-- Main Sources & Resources -->
      <sourceFolder url="file://$MODULE_DIR$/api/src/main/java" isTestSource="false" />
      <sourceFolder url="file://$MODULE_DIR$/api/src/main/resources" type="java-resource" />

